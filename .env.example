# Copier vers .env
# Neon : URL poolée (utilisée par l'app). Les migrations dérivent l'URL directe (ou définir DIRECT_URL).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
ANTHROPIC_API_KEY=""
# Facultatif : chemin vers Chrome/Chromium. Détection Chrome/Edge sur Windows ; Chromium embarqué sur Linux.
CAPTURE_CHROME_PATH=""
REMOTION_AWS_ACCESS_KEY_ID=""
REMOTION_AWS_SECRET_ACCESS_KEY=""
REMOTION_AWS_REGION="eu-central-1"
# Remplis après « npm run video:deploy-function » puis « npm run video:deploy » (redéployer le site après chaque modif de remotion/)
# Sans ces deux variables, l'export MP4 est simulé.
REMOTION_FUNCTION_NAME=""
REMOTION_SERVE_URL=""
# Quota AWS « Concurrent executions » (10 sur un compte neuf), partagé entre les rendus d'un export multi-formats
REMOTION_CONCURRENCY="10"

# Espace admin : hash du mot de passe admin (npm run admin:password). Le rôle admin se donne avec npm run admin:promote -- <email>
ADMIN_PASSWORD_HASH=

# Signature des jetons anti-bot de l'inscription (32 caractères minimum, aléatoire)
AUTH_SECRET=

# Limites de fréquence partagées entre instances (Upstash Redis, offre gratuite). Sans elles : mémoire du processus (dev uniquement)
# L'intégration Vercel KV fournit aussi KV_REST_API_URL / KV_REST_API_TOKEN, reconnues automatiquement.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protections IA : valeurs par défaut actives même si absentes du .env.
# Coupe-circuit : false désactive les appels payants (les réglages manuels restent disponibles).
AI_ENABLED=true
# Quotas globaux pour TOUS les comptes, sur une fenêtre de 24 h.
AI_GLOBAL_DAILY_CALLS=100
# Réservation prudente : tokens d'entrée estimés + marge + totalité de la sortie possible.
# Ce plafond de tokens ne remplace PAS le plafond monétaire du workspace Anthropic.
AI_GLOBAL_DAILY_TOKENS=1000000
# Vercel : automatique. Autre proxy : nom de l'en-tête qu'il ÉCRASE avec l'IP réelle.
# Ex. x-forwarded-for (dernière IP), cf-connecting-ip (origine accessible seulement via Cloudflare).
TRUSTED_IP_HEADER=

# Bucket R2 privé. Les quatre variables sont requises ensemble ; aucune clé NEXT_PUBLIC_.
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Stripe (paiements). Mode test d'abord (sk_test_…). Puis : npm run stripe:setup
STRIPE_SECRET_KEY=
# Local : affiché par « npm run stripe:listen ». Production : affiché par « npm run stripe:setup -- --webhook https://<domaine>/api/stripe/webhook »
STRIPE_WEBHOOK_SECRET=
# Protège le cron quotidien /api/cron/subscriptions (Vercel l'envoie automatiquement). 32 caractères aléatoires minimum
CRON_SECRET=
# URL publique du site (liens de retour Stripe, CGV, sitemap). Production : https://<domaine>
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notifications Telegram (inscriptions, achats, support). Vides : aucun envoi.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
