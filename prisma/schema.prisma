// Schéma Kinetik.
// Base Postgres (Neon).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Auth ─────────────────────────

enum UserRole {
  USER
  /// Accès au tableau de bord /admin (en plus du mot de passe admin, voir lib/admin/auth.ts)
  ADMIN
}

enum Plan {
  FREE
  STARTER
  PRO
  RESTO
}

model User {
  id                      String    @id @default(cuid())
  name                    String
  email                   String    @unique
  /// null pour les comptes créés uniquement via OAuth (Google / Discord)
  passwordHash            String?
  emailVerified           DateTime?
  image                   String?
  role                    UserRole  @default(USER)
  plan                    Plan      @default(FREE)
  /// Date de renouvellement de l'abonnement (expiration des crédits d'abonnement)
  planRenewsAt            DateTime?
  /// Stripe : copie de l'état de l'abonnement, resynchronisée à chaque webhook (Stripe reste la source de vérité)
  stripeCustomerId        String?   @unique
  stripeSubscriptionId    String?   @unique
  /// active, past_due, canceled… (null = jamais abonné)
  subscriptionStatus      String?
  /// month | year
  subscriptionInterval    String?
  /// Début de la période facturée en cours (les crédits sont attribués par tranches mensuelles depuis cette date)
  subscriptionPeriodStart DateTime?
  /// Résiliation demandée : l'abonnement s'arrête à planRenewsAt
  cancelAtPeriodEnd       Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  brandKits          BrandKit[]
  urlVideoAnalyses   UrlVideoAnalysis[]
  projects           Project[]
  creditTransactions CreditTransaction[]
  aiUsages           AiUsage[]
  restaurants        Restaurant[]
}

/// Comptes OAuth liés (Google, Discord…). Prévu pour plus tard.
model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String // "google" | "discord"
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Sessions serveur. Le cookie contient un token aléatoire, la base n'en stocke que le hash SHA-256.
model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  userAgent  String?
  /// Déverrouillage admin (mot de passe admin saisi) : valable jusqu'à cette date, pour cette session seulement
  adminUntil DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── Marque ─────────────────────────

model BrandKit {
  id          String   @id @default(cuid())
  userId      String
  name        String   @default("Ma marque")
  /// Liste de couleurs hex, ex. ["#7C3AED", "#0EA5E9"]
  colors      Json     @default("[]")
  headingFont String?
  bodyFont    String?
  sourceUrl   String?
  brief       Json?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets Asset[]

  @@index([userId])
}

model UrlVideoAnalysis {
  id                String   @id @default(cuid())
  userId            String
  data              Json
  projectIds        String[] @default([])
  settledProjectIds String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ───────────────────────── Projets ─────────────────────────

enum ProjectStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

enum VideoFormat {
  LANDSCAPE // 16:9
  PORTRAIT // 9:16
  SQUARE // 1:1
}

model Project {
  id              String        @id @default(cuid())
  userId          String
  name            String
  appName         String
  /// MOTION ou POST (posts et carrousels Instagram)
  kind            String        @default("MOTION")
  videoType       String        @default("presentation")
  locale          String        @default("fr")
  status          ProjectStatus @default(DRAFT)
  format          VideoFormat   @default(LANDSCAPE)
  /// Durée en secondes (15 / 30 / 45 / 60)
  duration        Int           @default(30)
  /// Identifiant du style (voir config/styles.ts) — null si images de référence
  styleId         String?
  /// Couleurs choisies pour ce projet
  colors          Json          @default("[]")
  /// Piste de la bibliothèque, ou null si musique uploadée (voir Asset MUSIC)
  musicTrackId    String?
  brief           String?
  /// Contenu d'un pack de la semaine (offre Resto) : téléchargeable sans débit une fois le pack validé
  restoPackId     String?
  websiteUrl      String?
  /// Jeton du lien de partage public (/share/<token>) ; null = partage désactivé
  shareToken      String?       @unique
  /// Projet d'origine quand ce projet est une déclinaison (autre format, version courte)
  sourceProjectId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  restoPack   RestoPack?       @relation(fields: [restoPackId], references: [id], onDelete: SetNull)
  versions    ProjectVersion[]
  messages    ChatMessage[]
  assets      Asset[]
  renders     Render[]
  postExports PostExport[]

  @@index([restoPackId])
  @@index([userId, updatedAt])
}

model PostExport {
  id         String       @id @default(cuid())
  projectId  String
  versionId  String
  requestId  String       @unique
  status     RenderStatus @default(PENDING)
  format     String
  files      String[]     @default([])
  creditCost Int
  createdAt  DateTime     @default(now())
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String
  number    Int
  /// Description des scènes produite par l'IA (timeline, animations, textes…)
  scenes    Json
  /// Résumé lisible de la modification
  label     String
  /// Message du chat à l'origine de cette version (null pour le premier jet)
  messageId String?  @unique
  createdAt DateTime @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id        String   @id @default(cuid())
  projectId String
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version ProjectVersion?

  @@index([projectId, createdAt])
}

enum AssetType {
  LOGO
  SCREEN
  BACKGROUND
  REFERENCE
  MUSIC
}

model Asset {
  id         String    @id @default(cuid())
  type       AssetType
  /// URL de stockage (Cloudflare R2 plus tard)
  url        String
  fileName   String
  mimeType   String?
  sizeBytes  Int?
  /// Images : dimensions en px (zoom / découpe précis sur un screen)
  width      Int?
  height     Int?
  /// Musique : tempo détecté à l'upload et position du premier temps (secondes)
  bpm        Float?
  beatOffset Float?
  position   Int       @default(0)
  projectId  String?
  brandKitId String?
  createdAt  DateTime  @default(now())

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brandKit BrandKit? @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([brandKitId])
}

enum RenderStatus {
  PENDING
  RENDERING
  DONE
  FAILED
}

enum RenderQuality {
  SD // 720p
  HD // 1080p
  UHD // 4K (plus proposé, conservé pour les anciens rendus)
}

model Render {
  id             String        @id @default(cuid())
  projectId      String
  versionId      String?
  status         RenderStatus  @default(PENDING)
  /// 0 → 100
  progress       Int           @default(0)
  format         VideoFormat
  quality        RenderQuality @default(HD)
  watermark      Boolean       @default(false)
  url            String?
  /// Remotion Lambda : identifiant du rendu et bucket S3 (null en mode simulé)
  lambdaRenderId String?
  bucketName     String?
  /// Clé S3 du MP4 final (l'URL de téléchargement est signée à la demande)
  outputKey      String?
  creditCost     Int
  error          String?
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ───────────────────────── Crédits (ledger) ─────────────────────────

enum CreditTransactionType {
  SIGNUP_BONUS
  GENERATION
  EDIT
  EXPORT
  PURCHASE
  SUBSCRIPTION
  REFUND
  EXPIRATION
  /// Crédits donnés ou retirés par un admin
  ADJUSTMENT
}

enum CreditSource {
  /// Crédits d'abonnement : expirent au renouvellement
  SUBSCRIPTION
  /// Crédits de packs (et bonus) : n'expirent pas
  PACK
}

/// Ledger : chaque mouvement est une ligne (+ crédit, − débit). Le solde est la somme.
model CreditTransaction {
  id          String                @id @default(cuid())
  userId      String
  amount      Int
  type        CreditTransactionType
  source      CreditSource          @default(PACK)
  description String
  /// Référence métier : id de projet, de render, de paiement Stripe…
  reference   String?
  expiresAt   DateTime?
  createdAt   DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Coût réel des demandes IA facturées selon leur complexité (chat de l’éditeur) : suivi de la rentabilité du barème.
model AiUsage {
  id               String   @id @default(cuid())
  userId           String
  projectId        String?
  operation        String
  plan             Plan
  turns            Int
  previews         Int
  inputTokens      Int
  cacheReadTokens  Int
  cacheWriteTokens Int
  outputTokens     Int
  /// Coût réel estimé, en millionièmes de dollar
  costMicroUsd     Int
  /// Crédits finalement débités (0 si rien n’a changé)
  credits          Int
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Journal des actions admin. Sans clé étrangère : l'historique survit à la suppression des comptes concernés.
model AdminLog {
  id          String   @id @default(cuid())
  adminId     String
  adminEmail  String
  /// unlock, credits.grant, credits.revoke, user.delete, project.delete…
  action      String
  targetType  String?
  targetId    String?
  /// Libellé lisible de la cible au moment de l'action (email, nom de projet)
  targetLabel String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// Réglages admin d'un template de la galerie (les templates eux-mêmes sont dans config/). Absent = visible, pas populaire.
model TemplateSetting {
  /// Catégorie de la galerie : motion, product, logo, post, store, decor
  kind       String
  templateId String
  /// Masqué de toutes les galeries (les projets existants qui l'utilisent continuent de marcher)
  hidden     Boolean  @default(false)
  /// Mis en avant avec le badge « Populaire » (8 max par catégorie)
  popular    Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@id([kind, templateId])
}

// ───────────────────────── Claude privé (contenu Créations) ─────────────────────────

/// Vidéo écrite librement par Claude depuis l'admin (/admin/studio), publiable dans la galerie « Créations ».
model CustomMotion {
  id        String   @id @default(cuid())
  name      String
  /// Code TSX du brouillon (écrit par Claude), et sa version compilée
  source    String   @default("")
  compiled  String   @default("")
  /// Réglages déclarés : types de scènes, textes, couleurs, formats (lib/custom-motion/contract.ts)
  meta      Json     @default("{}")
  /// Contenu par défaut : scènes, textes, couleurs, musique (CustomMotionDemo)
  demo      Json     @default("{}")
  /// Images envoyées dans le studio : { nom: url }
  assets    Json     @default("{}")
  /// Miniature de la carte dans la galerie (URL /api/uploads/community/…), null = dégradé de la palette
  thumbnail String?
  /// Visible dans la galerie (dernière version publiée)
  published Boolean  @default(false)
  popular   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions CustomMotionVersion[]
  messages CustomMotionMessage[]
}

/// Version figée et publiée : les projets des utilisateurs y restent attachés (styleId = "community:<id de version>").
model CustomMotionVersion {
  id        String   @id @default(cuid())
  motionId  String
  number    Int
  source    String
  compiled  String
  meta      Json
  demo      Json
  assets    Json     @default("{}")
  createdAt DateTime @default(now())

  motion CustomMotion @relation(fields: [motionId], references: [id], onDelete: Cascade)

  @@unique([motionId, number])
}

/// Conversation du studio avec Claude. `source` : le code après ce message (pour revenir en arrière).
model CustomMotionMessage {
  id        String   @id @default(cuid())
  motionId  String
  role      String
  content   String
  source    String?
  meta      Json?
  demo      Json?
  createdAt DateTime @default(now())

  motion CustomMotion @relation(fields: [motionId], references: [id], onDelete: Cascade)

  @@index([motionId, createdAt])
}

/// Niche Resto : le restaurant d'un compte (un seul pour l'instant ; la liste permettra plusieurs établissements plus tard).
/// Le logo et les couleurs vivent dans le brand kit lié, comme pour les autres contenus.
model Restaurant {
  id           String    @id @default(cuid())
  userId       String
  name         String
  /// Type de cuisine affiché et utilisé pour les accroches (« bistrot », « pizzeria »…)
  cuisine      String?
  address      String?
  phone        String?
  website      String?
  /// Horaires de la semaine : [{ day: 0-6 (lundi = 0), ranges: [{ open: "12:00", close: "14:30" }] }]
  hours        Json      @default("[]")
  /// Fermetures exceptionnelles : [{ from: "2026-12-24", to: "2027-01-02", note?: string }]
  closures     Json      @default("[]")
  /// Style préféré des contenus (id de config/resto-templates.ts)
  styleId      String?
  brandKitId   String?
  /// Identifiant Google Places (dernière phase ; seul champ conservable sans limite de durée)
  placeId      String?
  /// Rythme choisi à l'accueil : contenus voulus dans le pack (ids de config/resto-templates.ts)
  packContents String[]  @default([])
  /// Réseaux où le restaurant publie (instagram, facebook, tiktok, google)
  networks     String[]  @default([])
  /// Jour de préparation du pack (lundi = 0) ; l'heure est fixe (cron quotidien)
  packDay      Int       @default(0)
  packEnabled  Boolean   @default(true)
  /// Accueil terminé (les 3 vidéos de bienvenue ont été créées)
  onboardedAt  DateTime?
  /// Langue des contenus préparés (celle du site à l'accueil)
  locale       String    @default("fr")
  /// Recharge automatique : un pack de 100 crédits quand le solde ne couvre plus le pack à valider (consentement explicite)
  autoTopUp    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories MenuCategory[]
  dishes     Dish[]
  packs      RestoPack[]

  @@index([userId])
}

/// Catégorie de la carte (Entrées, Plats, Desserts, Boissons…)
model MenuCategory {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes     Dish[]

  @@index([restaurantId, position])
}

/// Origine d'un plat : la règle produit est qu'aucun plat ni prix n'est inventé.
enum DishSource {
  /// Saisi ou corrigé par le restaurateur
  MANUAL
  /// Lu sur la carte importée (photo, PDF, texte) : à confirmer tant que verified = false
  MENU_IMPORT
}

model Dish {
  id             String     @id @default(cuid())
  restaurantId   String
  categoryId     String?
  name           String
  description    String?
  /// Prix en centimes ; null = prix non indiqué (jamais deviné)
  priceCents     Int?
  source         DishSource @default(MANUAL)
  /// Confirmé par le restaurateur. Les plats lus sur la carte restent à confirmer avant toute publication.
  verified       Boolean    @default(true)
  /// Plat phare, mis en avant en priorité
  featured       Boolean    @default(false)
  /// Toujours à la carte (un plat retiré est gardé pour l'historique des contenus)
  active         Boolean    @default(true)
  /// Dernière mise en avant dans un pack : sert à la rotation des plats
  lastFeaturedAt DateTime?
  position       Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  photos     DishPhoto[]

  @@index([restaurantId, active])
  @@index([categoryId])
}

/// Photo d'un plat (fichier dans le dossier de l'utilisateur, comme les autres uploads)
model DishPhoto {
  id        String   @id @default(cuid())
  dishId    String
  url       String
  width     Int?
  height    Int?
  /// Point d'intérêt (0 à 1) : où se trouve le plat sur la photo, pour le recadrage
  focusX    Float?
  focusY    Float?
  /// Contour de l'assiette (Table 3D) : { cx, cy, rx, ry, angle } en proportions de l'image ; null si non repérée
  plate     Json?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId, position])
}

enum RestoPackStatus {
  /// En cours de préparation (contenus en création)
  PREPARING
  /// Prêt : le restaurateur valide, corrige ou retire chaque contenu
  READY
  /// Validé : crédits débités, contenus téléchargeables
  VALIDATED
  /// Rien à préparer (fermeture, carte vide…) : la raison est affichée, rien n'est débité
  SKIPPED
}

/// Pack de la semaine : préparé le jour choisi, validé depuis le téléphone. Jamais sauté sans explication.
model RestoPack {
  id           String          @id @default(cuid())
  restaurantId String
  userId       String
  /// Jour du pack (« AAAA-MM-JJ », heure de Paris) : un pack par restaurant et par jour de pack
  packDate     String
  status       RestoPackStatus @default(PREPARING)
  /// Contenus : [{ projectId, template, caption, dishIds, kept }]
  items        Json            @default("[]")
  /// Contenus demandés mais impossibles à préparer : [{ template, reason }]
  skipped      Json            @default("[]")
  /// Raison d'un pack sauté (closed, empty)
  reason       String?
  creditCost   Int             @default(0)
  validatedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  projects   Project[]

  @@unique([restaurantId, packDate])
  @@index([userId, packDate])
}
